{
  "name": "easytiny-mcp",
  "version": "0.2.0",
  "description": "MCP server for visually lossless batch image compression",
  "keywords": [
    "mcp",
    "image",
    "compression",
    "png",
    "jpeg",
    "webp",
    "avif"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaneasy/easytiny-mcp.git"
  },
  "homepage": "https://github.com/chaneasy/easytiny-mcp#readme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "easytiny-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsx src/index.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "bench": "tsx scripts/bench.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "tsx scripts/release.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.15.5",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
